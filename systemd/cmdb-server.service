[Unit]
Description=CMDB web server
After=network.target mariadb.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP@
EnvironmentFile=@DATABASE_ENV@
ExecStart=@APP@/.venv/bin/python -B -u @APP@/cmdb-server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
